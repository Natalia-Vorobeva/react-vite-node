{
	"rewrites": [
		{
			"source": "/api/:path*",
			"destination": "http://a0830433.xsph.ru/:path*"
		}
	],
	"env": {
    "VITE_API_BASE_URL": "/api"
  },
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "X-Frame-Options",
					"value": "DENY"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				}
			]
		}
	]
}